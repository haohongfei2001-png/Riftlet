{
  "manifest_version": 3,
  "name": "Riftlet original document experiment",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "scope.js",
        "document.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
