{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riftlet-feedback-receiver",
  "main": "receiver.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": { "ACCEPT_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "riftlet-feedback", "database_id": "REPLACE_AFTER_AUTHORIZATION" }]
}
