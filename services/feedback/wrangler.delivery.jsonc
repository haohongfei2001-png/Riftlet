{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riftlet-feedback-delivery",
  "main": "delivery.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "DELIVERY_ENABLED": "false", "GITHUB_REPOSITORY": "haohongfei2001-png/Riftlet-Feedback" },
  "d1_databases": [{ "binding": "DB", "database_name": "riftlet-feedback", "database_id": "REPLACE_AFTER_AUTHORIZATION" }]
}
