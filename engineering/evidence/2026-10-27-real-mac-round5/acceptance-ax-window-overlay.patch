+
+/// Temporary acceptance-only AX view of existing windows. No new AX root,
+/// focus claims, retained window snapshots, selection actions or upload grants.
+@MainActor
+private final class AcceptanceAXApplication: NSApplication {
+    var requestedAssetID: UUID?
+    private weak var preferredPanel: NSWindow?
+    private(set) var panelAssigned = false
+
+    private func reordered(_ elements: [Any]?) -> [Any]? {
+        guard let panel = preferredPanel, panel.isVisible,
+              var items = elements,
+              let index = items.firstIndex(where: { ($0 as? NSWindow) === panel })
+        else { return elements }
+        if index != 0 { items.insert(items.remove(at: index), at: 0) }
+        return items
+    }
+
+    override func accessibilityWindows() -> [Any]? {
+        reordered(super.accessibilityWindows())
+    }
+
+    override func accessibilityChildren() -> [Any]? {
+        reordered(super.accessibilityChildren())
+    }
+
+    func prioritizeExistingPanel(_ panel: NSWindow, assetID: UUID, initialWindowNumber: Int?) {
+        guard !panelAssigned, requestedAssetID == assetID, panel.isVisible else { return }
+        panelAssigned = true
+        preferredPanel = panel
+        let before = super.accessibilityWindows() ?? []
+        let children = super.accessibilityChildren() ?? []
+        panel.orderFrontRegardless()
+        let after = accessibilityWindows() ?? []
+        Self.record(["event": "acceptance_ax_panel_priority", "assetID": assetID.uuidString,
+            "windowNumber": panel.windowNumber, "actualClass": String(describing: type(of: self)),
+            "initialPreferredWindowNumber": initialWindowNumber ?? -1,
+            "initialPreferredPanelCreated": initialWindowNumber == panel.windowNumber,
+            "beforeAXWindowNumbers": before.compactMap { ($0 as? NSWindow)?.windowNumber },
+            "afterAXWindowNumbers": after.compactMap { ($0 as? NSWindow)?.windowNumber },
+            "beforeAXElementCount": before.count, "afterAXElementCount": after.count,
+            "candidateInAXWindows": before.contains { ($0 as? NSWindow) === panel },
+            "candidateInAXChildren": children.contains { ($0 as? NSWindow) === panel },
+            "uptime": ProcessInfo.processInfo.systemUptime, "directSelection": false,
+            "physicalInputClaim": false, "uploadStartGrant": false])
+    }
+
+    static func record(_ fields: [String: Any]) {
+        // At most startup plus one priority event. Never log from AX getters.
+        guard let data = try? JSONSerialization.data(withJSONObject: fields, options: [.sortedKeys]) else { return }
+        try? FileHandle.standardError.write(contentsOf: data + Data([10]))
     }
 }
 
